{
  "output": {
    "dataset_id": {
      "value": "${google_bigquery_dataset.foundation.dataset_id}"
    }
  },
  "resource": {
    "google_bigquery_dataset": {
      "foundation": {
        "dataset_id": "${var.dataset_id}",
        "delete_contents_on_destroy": false,
        "labels": "${var.labels}",
        "lifecycle": {
          "prevent_destroy": true
        },
        "location": "${var.region}",
        "project": "${var.project_id}",
        "storage_billing_model": "LOGICAL"
      }
    },
    "google_bigquery_dataset_iam_policy": {
      "metadata": {
        "dataset_id": "${google_bigquery_dataset.foundation.dataset_id}",
        "policy_data": "${jsonencode({bindings = [{role = \"roles/bigquery.dataOwner\", members = [var.dataset_owner]}, {role = var.metadata_role, members = [\"serviceAccount:${var.runner_email}\"]}]})}",
        "project": "${var.project_id}"
      }
    },
    "google_bigquery_table": {
      "products": {
        "dataset_id": "${google_bigquery_dataset.foundation.dataset_id}",
        "deletion_protection": true,
        "for_each": "${var.schemas}",
        "labels": "${var.labels}",
        "lifecycle": {
          "prevent_destroy": true
        },
        "project": "${var.project_id}",
        "schema": "${jsonencode(each.value)}",
        "table_id": "${each.key}"
      }
    },
    "google_bigquery_table_iam_member": {
      "runner": {
        "dataset_id": "${google_bigquery_dataset.foundation.dataset_id}",
        "for_each": "${var.schemas}",
        "member": "serviceAccount:${var.runner_email}",
        "project": "${var.project_id}",
        "role": "${contains([\"curated_transactions\", \"customers\", \"accounts\"], each.key) ? var.reader_role : var.table_role}",
        "table_id": "${google_bigquery_table.products[each.key].table_id}"
      }
    }
  },
  "variable": {
    "dataset_id": {
      "type": "string"
    },
    "dataset_owner": {
      "type": "string",
      "description": "M6T: approved user: direct dataset owner (BigQuery requires one; the policy is authoritative)."
    },
    "labels": {
      "type": "map(string)"
    },
    "metadata_role": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "reader_role": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "runner_email": {
      "type": "string"
    },
    "schemas": {
      "type": "map(list(object({name=string,type=string,mode=string})))"
    },
    "table_role": {
      "type": "string"
    }
  }
}
